{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "build",
    "node_modules",
    "server/public",
    "server/backup",
    "src/styles/materialize.min.css",
    "src/styles/resources/fonts",
    "src/serviceWorker.js"
  ]
}
